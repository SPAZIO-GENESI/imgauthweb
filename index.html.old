<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Attestazione opere digitali — impronta SHA-256 gratuita | Spazio Genesi</title>
<meta name="description" content="Dimostra che la tua opera digitale esisteva oggi, esattamente così com'è: impronta SHA-256, certificato PDF con marca temporale riconosciuta e ancoraggio nella blockchain di Bitcoin. Gratuito, open source, il file non viene conservato.">
<link rel="canonical" href="https://attestazione.spaziogenesi.org/">
<meta name="robots" content="index, follow">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="theme-color" content="#ffffff">

<!-- PWA: installabile sulla home screen (manifest + icone); nessun service worker,
     la pagina resta servita live da GitHub Pages come sempre -->
<link rel="manifest" href="/manifest.json">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="apple-mobile-web-app-title" content="Attestazione">

<!-- Open Graph / Twitter -->
<meta property="og:title" content="Attestazione opere digitali — Spazio Genesi">
<meta property="og:description" content="Impronta SHA-256, data certificata da terza parte e ancoraggio in Bitcoin. Gratuito e open source: il file non viene conservato.">
<meta property="og:image" content="https://attestazione.spaziogenesi.org/og.png">
<meta property="og:url" content="https://attestazione.spaziogenesi.org/">
<meta property="og:type" content="website">
<meta property="og:locale" content="it_IT">
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

<!-- Turnstile: challenge anti-bot richiesta solo per l'emissione del certificato PDF -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback" async defer></script>

<!-- pdf.js (auto-ospitato): lettura lato client del certificato PDF in fase di verifica.
     Servito dal nostro dominio per non dipendere da CDN di terze parti — coerente
     con la verificabilità del servizio. Aggiornare i file in /vendor/pdf/ a mano. -->
<script src="/vendor/pdf/pdf.min.js" defer></script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 300;
    background: #ffffff;
    color: #111111;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  header {
    text-align: center;
    padding: 2.8rem 1.5rem 0;
  }

  header h1 {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    color: #111;
    line-height: 1.2;
  }

  header h1 span { font-style: italic; color: #8B6914; }

  .tagline {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: #777;
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .divider {
    width: 48px;
    height: 1.5px;
    background: #8B6914;
    margin: 1.6rem auto 0;
  }

  .notice {
    background: #f9f9f7;
    border: 1px solid #e5e5e0;
    border-radius: 4px;
    padding: 0.75rem 1.2rem;
    font-size: 0.8rem;
    color: #666;
    line-height: 1.6;
    margin: 1.8rem auto 0;
    max-width: 540px;
    text-align: center;
  }

  main {
    flex: 1;
    max-width: 560px;
    margin: 0 auto;
    padding: 2.2rem 1.5rem 4rem;
    width: 100%;
  }

  label.field-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 500;
    color: #333;
    margin-bottom: 0.55rem;
    letter-spacing: 0.02em;
  }

  .drop-zone {
    border: 1.5px dashed #cccccc;
    border-radius: 6px;
    padding: 2.6rem 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.18s, background 0.18s;
    position: relative;
    background: #fafafa;
  }

  .drop-zone:hover,
  .drop-zone.over { border-color: #999; background: #f4f4f4; }

  .drop-zone input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .drop-primary {
    font-size: 0.9rem;
    color: #444;
    margin-bottom: 0.3rem;
  }

  .drop-hint {
    font-size: 0.73rem;
    color: #aaa;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .preview-row {
    display: none;
    align-items: center;
    gap: 1rem;
    margin-top: 1.2rem;
    padding: 0.9rem 1rem;
    background: #f7f7f5;
    border: 1px solid #e8e8e3;
    border-radius: 5px;
  }

  .preview-row.show { display: flex; }

  .preview-thumb {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid #ddd;
    flex-shrink: 0;
    background: #eee;
  }

  .preview-info { flex: 1; min-width: 0; }

  .preview-fname {
    font-size: 0.83rem;
    font-weight: 500;
    color: #222;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0.2rem;
  }

  .preview-fmeta {
    font-size: 0.75rem;
    color: #888;
  }

  .btn-row {
    margin-top: 1.4rem;
    display: flex;
    gap: 0.75rem;
  }

  button.primary {
    flex: 1;
    padding: 0.7rem 1.2rem;
    background: #111;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  button.primary:hover { background: #333; }
  button.primary:disabled { background: #bbb; cursor: not-allowed; }

  .spinner {
    display: none;
    width: 13px;
    height: 13px;
    border: 1.5px solid rgba(255,255,255,0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.65s linear infinite;
  }

  .loading .spinner { display: block; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .error-msg {
    display: none;
    margin-top: 0.9rem;
    padding: 0.7rem 1rem;
    background: #fff5f5;
    border: 1px solid #f5c6c6;
    border-radius: 4px;
    font-size: 0.78rem;
    color: #c0392b;
    line-height: 1.5;
  }

  .error-msg.show { display: block; }

  /* RESULT */
  .result-wrap {
    display: none;
    margin-top: 2.2rem;
  }

  .result-wrap.show { display: block; }

  .result-section-title {
    font-family: 'EB Garamond', serif;
    font-size: 1.15rem;
    font-style: italic;
    color: #333;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid #e5e5e0;
  }

  .hash-block {
    background: #f7f7f5;
    border: 1px solid #e5e5e0;
    border-radius: 5px;
    padding: 1rem 1.1rem;
    position: relative;
    margin-bottom: 1rem;
  }

  .hash-label-small {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #aaa;
    margin-bottom: 0.45rem;
  }

  .hash-string {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.78rem;
    color: #111;
    word-break: break-all;
    line-height: 1.6;
  }

  .btn-copy {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 3px;
    font-size: 0.68rem;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.08em;
    padding: 3px 9px;
    cursor: pointer;
    color: #555;
    transition: border-color 0.15s, color 0.15s;
  }

  .btn-copy:hover { border-color: #999; color: #111; }
  .btn-copy.ok { border-color: #2e7d32; color: #2e7d32; }

  .meta-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
    margin-bottom: 1rem;
  }

  .meta-table tr { border-bottom: 1px solid #efefec; }
  .meta-table tr:last-child { border-bottom: none; }

  .meta-table td {
    padding: 0.55rem 0.2rem;
    vertical-align: top;
  }

  .meta-table td:first-child {
    color: #888;
    width: 38%;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    padding-top: 0.6rem;
  }

  .meta-table td:last-child { color: #222; font-weight: 400; }

  .attestation-block {
    margin-top: 0.5rem;
    padding: 0.8rem 1rem;
    border-left: 2px solid #111;
    background: #f7f7f5;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.72rem;
    color: #555;
    word-break: break-all;
    line-height: 1.65;
    border-radius: 0 4px 4px 0;
  }

  .attestation-block strong {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #aaa;
    margin-bottom: 0.4rem;
    font-weight: 400;
  }

  .btn-download {
    margin-top: 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.1rem;
    background: transparent;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 400;
    color: #333;
    cursor: pointer;
    letter-spacing: 0.04em;
    transition: border-color 0.15s, color 0.15s;
    text-decoration: none;
  }

  .btn-download:hover { border-color: #111; color: #111; }

  footer {
    text-align: center;
    padding: 1.5rem;
    font-size: 0.75rem;
    color: #aaa;
    border-top: 1px solid #eee;
  }

  footer a { color: #888; text-decoration: none; }
  footer a:hover { text-decoration: underline; }

  @media (max-width: 480px) {
    header { padding: 2rem 1rem 0; }
    main { padding: 1.8rem 1rem 3rem; }
  }

  /* ── Riorganizzazione 1.6.0: brand bar, tab, passi, gerarchia azioni ── */
  :root { --oro: #8B6914; --oro-scuro: #745609; }

  .brandbar { display: flex; align-items: center; justify-content: space-between;
    max-width: 760px; margin: 0 auto; padding: 1.1rem 1.5rem 0; width: 100%; }
  .brandbar a { text-decoration: none; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; color: #111;
    font-size: 0.92rem; font-weight: 500; letter-spacing: 0.02em; }
  .brand svg { display: block; }
  .brand:hover { color: var(--oro); }
  .link-servizi { font-size: 0.78rem; color: #777; border-bottom: 1px dotted #bbb; padding-bottom: 1px; }
  .link-servizi:hover { color: var(--oro); border-color: var(--oro); }

  .tabs { display: flex; border: 1px solid #e5e5e0; border-radius: 6px; overflow: hidden; margin: 0 0 1.6rem; }
  .tabs button { flex: 1; padding: 0.75rem 0.5rem; background: #f9f9f7; border: none;
    font-family: 'Inter', sans-serif; font-size: 0.85rem; font-weight: 500;
    letter-spacing: 0.03em; color: #777; cursor: pointer; }
  .tabs button.attiva { background: var(--oro); color: #fff; }
  .tabs button:not(.attiva):hover { color: #111; }
  .tab-nascosta { display: none; }

  .passo { display: flex; gap: 0.8rem; align-items: baseline; margin: 1.7rem 0 0.6rem; }
  .passo .n { flex: 0 0 auto; width: 1.5rem; height: 1.5rem; border-radius: 50%;
    background: var(--oro); color: #fff; font-size: 0.78rem; font-weight: 500;
    display: inline-flex; align-items: center; justify-content: center; transform: translateY(0.18rem); }
  .passo h2 { font-family: 'EB Garamond', serif; font-weight: 500; font-size: 1.18rem; color: #111; }
  .passo .hint { font-size: 0.76rem; color: #999; margin-left: auto; }

  details.opz { border: 1px solid #e5e5e0; border-radius: 6px; padding: 0.65rem 0.95rem; }
  details.opz summary { cursor: pointer; font-size: 0.83rem; color: #555; list-style: none;
    display: flex; align-items: center; gap: 0.5rem; }
  details.opz summary::-webkit-details-marker { display: none; }
  details.opz summary::before { content: "+"; color: var(--oro); font-weight: 600; }
  details.opz[open] summary::before { content: "–"; }

  .risultato-card { border: 1px solid #e5e5e0; border-radius: 10px;
    padding: 1.4rem 1.3rem 1.5rem; background: #fffefb; }
  .ris-ok { color: #1e7e34; }

  details.tecnici summary { cursor: pointer; font-size: 0.78rem; color: #888; list-style: none; }
  details.tecnici summary::-webkit-details-marker { display: none; }
  details.tecnici summary::before { content: "+ "; color: var(--oro); font-weight: 600; }
  details.tecnici[open] summary::before { content: "– "; }

  .azioni { margin-top: 1.4rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .azione-primaria { display: flex; align-items: center; justify-content: center; gap: 0.55rem;
    padding: 0.95rem 1.2rem; background: var(--oro); color: #fff; border: none; border-radius: 6px;
    font-family: 'Inter', sans-serif; font-size: 0.92rem; font-weight: 600; letter-spacing: 0.03em;
    cursor: pointer; width: 100%; }
  .azione-primaria:hover { background: var(--oro-scuro); }
  .azione-primaria:disabled { cursor: progress; opacity: 0.85; }
  .azione-primaria.loading #pdfBtnIcon { display: none; }
  .azione-secondaria { display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.7rem 1.2rem; background: #fff; color: #111; border: 1.5px solid #111;
    border-radius: 6px; font-family: 'Inter', sans-serif; font-size: 0.82rem; font-weight: 500;
    cursor: pointer; width: 100%; }
  .azione-secondaria:hover { background: #f9f9f7; }
  .azione-terziaria { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.78rem;
    color: #555; text-decoration: none; margin: 0.2rem auto 0; border-bottom: 1px dotted #bbb;
    padding-bottom: 1px; }
  .azione-terziaria:hover { color: var(--oro); border-color: var(--oro); }
  .microcopy { font-size: 0.73rem; color: #999; text-align: center; margin-top: 0.4rem; line-height: 1.6; }

  footer .riga-brand { display: flex; align-items: center; justify-content: center;
    gap: 0.5rem; margin-bottom: 0.5rem; color: #555; }

  /* ── Scheda Istruzioni: testo + garanzie a tendina (specchio di /servizi) ── */
  .istr p { font-size: 0.88rem; color: #555; line-height: 1.65; margin: 0.7rem 0; }
  .istr p strong, .istr li strong { color: #111; font-weight: 600; }
  .istr ol.passi { margin: 0.6rem 0 0.6rem 1.3rem; font-size: 0.88rem; color: #555; line-height: 1.65; }
  .istr ol.passi li { margin: 0.35rem 0; }
  .istr a { color: var(--oro); text-decoration: none; }
  .istr a:hover { text-decoration: underline; }
  .istr video { width: 100%; border-radius: 8px; border: 1px solid #e5e5e0; margin: 0.8rem 0 0.4rem; }
  .istr h3 { font-family: 'EB Garamond', serif; font-weight: 500; font-size: 1.25rem; color: #111; margin: 1.8rem 0 0.2rem; }
  .garanzie { border-top: 1px solid #e5e5e0; margin-top: 0.7rem; }
  details.g { border-bottom: 1px solid #e5e5e0; }
  details.g summary { cursor: pointer; list-style: none; display: flex; align-items: baseline;
    gap: 0.7rem; padding: 0.8rem 0.1rem; user-select: none; }
  details.g summary::-webkit-details-marker { display: none; }
  details.g summary .segno { flex: 0 0 auto; width: 1rem; color: var(--oro); font-weight: 600;
    transition: transform 0.18s ease; text-align: center; }
  details.g[open] summary .segno { transform: rotate(45deg); }
  details.g summary .titolo { font-weight: 600; font-size: 0.9rem; color: #111; }
  details.g summary:hover .titolo { color: var(--oro); }
  details.g summary .breve { color: #888; font-size: 0.8rem; font-weight: 300; }
  details.g .corpo { padding: 0 0.1rem 1rem 1.7rem; font-size: 0.83rem; color: #666; line-height: 1.65; }
  details.g .corpo p { margin: 0.4rem 0; font-size: 0.83rem; }
  details.g .corpo ol { margin: 0.4rem 0 0.4rem 1.2rem; }
  details.g .corpo li { margin: 0.25rem 0; }
  .badge-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem;
    padding-top: 0.6rem; margin-top: 0.5rem; border-top: 1px solid #efefec; }
  .badge { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.22rem 0.65rem;
    border: 1px solid #e5e5e0; border-radius: 999px; background: #f9f9f7; font-size: 0.72rem;
    color: #333; text-decoration: none; }
  a.badge:hover { border-color: var(--oro); color: var(--oro); }
  .nota-box { margin-top: 1.4rem; padding: 0.8rem 1rem; background: #f9f9f7;
    border: 1px solid #e5e5e0; border-radius: 6px; font-size: 0.8rem; color: #666; line-height: 1.6; }

  #donaLink { transition: background 0.15s, transform 0.15s, box-shadow 0.15s; }
  #donaLink:hover { background: var(--oro-scuro) !important;
    box-shadow: 0 4px 14px rgba(139,105,20,0.4) !important; transform: translateY(-1px); }

  /* ── Stato semaforico dei servizi ── */
  .svc-panel { border: 1px solid #e5e5e0; border-radius: 8px; overflow: hidden; margin-top: 0.6rem; }
  .svc-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.62rem 0.9rem;
    font-size: 0.85rem; color: #333; border-top: 1px solid #efefec; }
  .svc-row:first-child { border-top: none; }
  .svc-dot { flex: 0 0 auto; width: 10px; height: 10px; border-radius: 50%; background: #c4c4c4;
    box-shadow: 0 0 0 3px rgba(0,0,0,0.03); }
  .svc-dot.ok { background: #1e7e34; }
  .svc-dot.down { background: #c0392b; }
  .svc-dot.degraded { background: #d4a017; }
  .svc-dot.na { background: #c4c4c4; }
  .svc-state { margin-left: auto; font-size: 0.74rem; color: #999; }
  .svc-checked { font-size: 0.74rem; color: #aaa; margin-top: 0.5rem; }
  .svc-footer { display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 0.5rem;
    font-size: 0.78rem; color: #777; }
</style>
  <!-- Matomo -->
  <script>
    var _paq = window._paq = window._paq || [];
    /* Analitica senza cookie + IP anonimizzato (lato server): nessun consenso
       richiesto, nessun banner. Vedi privacy.html § 3.4. */
    _paq.push(['disableCookies']);
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
    var u="//matomodocker.azurewebsites.net/";
    _paq.push(['setTrackerUrl', u+'matomo.php']);
    _paq.push(['setSiteId', '7']);
